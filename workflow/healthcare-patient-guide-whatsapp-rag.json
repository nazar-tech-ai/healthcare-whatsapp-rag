    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  for (const bin of Object.values(item.binary || {})) {\n    out.push({\n      json: { fileName: bin.fileName },\n      binary: { data: bin }\n    });\n  }\n}\nreturn out;"
      },
      "id": "9d136e63-40cd-4f86-a86c-43268f021d3c",
      "name": "Split Files Into Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "46f78d42-33ab-4f5d-b0a1-494001dac12a",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        -64,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const MAX = 1500;\nconst OVERLAP = 200;\nconst results = [];\n\n// Optional (local testing only, do not commit real numbers):\n// map an MRN to your own WhatsApp number, e.g. { 'MRN-2026-51067': '923XXXXXXXXX' }\nconst TEST_PHONES = {};\n\n$input.all().forEach((item, idx) => {\n  const text = (item.json.text || '').replace(/\\r/g, '');\n\n  let fileName = '';\n  try { fileName = $('Split Files Into Items').all()[idx].json.fileName || ''; } catch (e) {}\n\n  const names = [...text.matchAll(/Full Name\\s+(.+)/g)].map(m => m[1].trim());\n  const phones = [...text.matchAll(/Phone\\s+(\\+[\\d-]+)/g)].map(m => m[1].trim());\n  const patient = names[1] || 'Unknown';\n  const mrn = (text.match(/MRN-\\d{4}-\\d+/) || [''])[0];\n  const patientPhone = TEST_PHONES[mrn] || (phones[1] || '').replace(/\\D/g, '');\n  const docRef = (text.match(/Document Reference:\\s*(\\S+)/) || [null, ''])[1];\n  const planDate = ((text.match(/Plan Date\\s+(.+)/) || [null, ''])[1] || '').trim();\n\n  const header = `[Patient: ${patient} | MRN: ${mrn} | Plan date: ${planDate} | Ref: ${docRef}]`;\n\n  const sections = text.split(/(?=CLAUSE\\s+\\d+)/).map(s => s.trim()).filter(s => s.length > 30);\n\n  let n = 0;\n  for (const sec of sections) {\n    for (let i = 0; i < sec.length; i += (MAX - OVERLAP)) {\n      results.push({\n        json: {\n          text: `${header}\\n${sec.substring(i, i + MAX)}`,\n          fileName, chunk: n++, patient, mrn, patientPhone\n        }\n      });\n      if (i + MAX >= sec.length) break;\n    }\n  }\n});\n\nreturn results;"
      },
